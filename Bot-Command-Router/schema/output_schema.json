{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BotCommandRouterOutput",
  "description": "Structured intent payload produced by the Bot-Command-Router skill.",
  "type": "object",
  "required": ["intent", "extracted_parameters", "confidence"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "get_lead_status",
        "run_ads_txt_check",
        "get_daily_summary",
        "unknown_command"
      ],
      "description": "Classified intent of the user message."
    },
    "extracted_parameters": {
      "type": "object",
      "required": ["domain", "date_range"],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": ["string", "null"],
          "description": "Hostname extracted from the message (e.g. 'example.com'). Null if not present."
        },
        "date_range": {
          "type": ["string", "null"],
          "description": "Date or date range extracted from the message (e.g. 'last week', 'yesterday'). Null if not present."
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Model confidence in the intent classification (0.0–1.0)."
    }
  },
  "examples": [
    {
      "intent": "get_lead_status",
      "extracted_parameters": { "domain": "example.com", "date_range": null },
      "confidence": 0.97
    },
    {
      "intent": "run_ads_txt_check",
      "extracted_parameters": { "domain": "publisher-news.net", "date_range": null },
      "confidence": 0.96
    },
    {
      "intent": "get_daily_summary",
      "extracted_parameters": { "domain": null, "date_range": null },
      "confidence": 0.82
    },
    {
      "intent": "unknown_command",
      "extracted_parameters": { "domain": null, "date_range": null },
      "confidence": 0.99
    }
  ]
}
