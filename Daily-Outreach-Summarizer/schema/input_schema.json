{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyOutreachSummarizerInput",
  "description": "Array of outreach events to be aggregated into a daily report.",
  "type": "array",
  "minItems": 0,
  "items": {
    "type": "object",
    "required": ["event", "domain", "reply_text"],
    "additionalProperties": false,
    "properties": {
      "event": {
        "type": "string",
        "enum": ["sent", "open", "reply"],
        "description": "Type of outreach event."
      },
      "domain": {
        "type": "string",
        "description": "Domain associated with this event (e.g. 'example.com')."
      },
      "reply_text": {
        "type": ["string", "null"],
        "description": "Text of the reply. Required when event is 'reply'. Null otherwise."
      }
    }
  },
  "examples": [
    [
      {"event": "sent", "domain": "a.com", "reply_text": null},
      {"event": "sent", "domain": "b.com", "reply_text": null},
      {"event": "open", "domain": "a.com", "reply_text": null},
      {"event": "reply", "domain": "b.com", "reply_text": "not interested"},
      {"event": "reply", "domain": "c.com", "reply_text": "send more info"}
    ]
  ]
}
